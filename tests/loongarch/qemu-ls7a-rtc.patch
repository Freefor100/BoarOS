+/* Direct comparison IRQs and the PM event are distinct hardware owners. */
+static void ls7a_update_irq(LS7ARtcState *s)
+{
+    qemu_set_irq(s->irq, (toy_enabled(s) && s->toy_pending) ||
+                        (rtc_enabled(s) && s->rtc_pending));
+    qemu_set_irq(s->pm_irq, (s->pm_sts & s->pm_en & RTC_EVENT) &&
+                          (s->pm_cnt & 1));
+}
+
+static void schedule_toy(LS7ARtcState *s, int num)
+{
+    struct tm tm, check;
+    int64_t delta, now;
+
+    timer_del(s->toy_timer[num]);
+    if (!toy_enabled(s)) {
+        return;
+    }
+    toymatch_val_to_time(s, s->toymatch[num], &tm);
+    /* Zero/invalid calendar values disable comparison, including ISR ack. */
+    if (tm.tm_mon < 0 || tm.tm_mon > 11 || tm.tm_mday < 1 ||
+        tm.tm_mday > 31 || tm.tm_hour > 23 || tm.tm_min > 59 ||
+        tm.tm_sec > 59) {
+        return;
+    }
+    check = tm;
+    time_t epoch = mktimegm(&check);
+    gmtime_r(&epoch, &check);
+    if (check.tm_mon != tm.tm_mon || check.tm_mday != tm.tm_mday) {
+        return;
+    }
+    delta = qemu_timedate_diff(&tm) - s->offset_toy;
+    /* The match year repeats every 64 years; past matches are not expired IRQs. */
+    if (delta < 0) {
+        tm.tm_year += 64;
+        delta = qemu_timedate_diff(&tm) - s->offset_toy;
+    }
+    now = qemu_clock_get_ms(rtc_clock);
+    timer_mod(s->toy_timer[num], now + delta * 1000);
+}
+
+static void schedule_rtc(LS7ARtcState *s, int num)
+{
+    uint32_t count, distance;
+    timer_del(s->rtc_timer[num]);
+    if (!rtc_enabled(s)) {
+        return;
+    }
+    count = ls7a_rtc_ticks() + s->offset_rtc;
+    distance = s->rtcmatch[num] - count;
+    timer_mod_ns(s->rtc_timer[num], qemu_clock_get_ns(rtc_clock) +
+                 ticks_to_ns(distance));
+}
