+static uint64_t ls7a_pm_read(void *opaque, hwaddr addr, unsigned size)
+{
+    LS7ARtcState *s = opaque;
+    switch (addr) {
+    case PM1_STS: return s->pm_sts;
+    case PM1_EN: return s->pm_en;
+    case PM1_CNT: return s->pm_cnt;
+    default:
+        qemu_log_mask(LOG_UNIMP, "ls7a RTC PM: unsupported read 0x%" HWADDR_PRIx "\n", addr);
+        return 0;
+    }
+}
+
+static void ls7a_pm_write(void *opaque, hwaddr addr, uint64_t val, unsigned size)
+{
+    LS7ARtcState *s = opaque;
+    switch (addr) {
+    case PM1_STS: s->pm_sts &= ~(val & RTC_EVENT); break;
+    case PM1_EN: s->pm_en = val & RTC_EVENT; break;
+    case PM1_CNT: s->pm_cnt = val & 1; break;
+    default:
+        qemu_log_mask(LOG_UNIMP, "ls7a RTC PM: unsupported write 0x%" HWADDR_PRIx "\n", addr);
+        return;
+    }
+    ls7a_update_irq(s);
+}
