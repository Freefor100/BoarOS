CONFIG_64BIT=y
CONFIG_MMU=y
CONFIG_ARCH_VIRT=y
CONFIG_NONPORTABLE=y
CONFIG_SMP=n
CONFIG_RISCV_ISA_C=y
CONFIG_RISCV_ISA_V=n
CONFIG_FPU=y
CONFIG_COMPAT=n
CONFIG_MODULES=n
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_INITRD=n
CONFIG_BINFMT_ELF=y
CONFIG_COREDUMP=n
CONFIG_PRINTK=y
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_RISCV_SBI=y
CONFIG_RISCV_SBI_V01=y
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_SYSCON=y
CONFIG_RISCV_SBI_CPUIDLE=n
CONFIG_SYSFS=y
CONFIG_PROC_FS=y
CONFIG_SYSCTL=y
CONFIG_EXPERT=y
CONFIG_EMBEDDED=y
CONFIG_IO_URING=n
CONFIG_DEBUG_KERNEL=n
CONFIG_LOCALVERSION_AUTO=n
CONFIG_LOCALVERSION="-boaros-diff"
# User-program reference environment: these capabilities must be present
# before attributing upstream test failures to BoarOS.
CONFIG_BINFMT_SCRIPT=y
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_POSIX_TIMERS=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_FILE_LOCKING=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y
CONFIG_UNIX98_PTYS=y
CONFIG_MULTIUSER=y
CONFIG_FHANDLE=y
CONFIG_AIO=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_GOLDFISH=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_HCTOSYS_DEVICE="rtc0"
CONFIG_RTC_INTF_DEV=y
CONFIG_RTC_INTF_SYSFS=y
CONFIG_FUTEX_PI=y
